---
interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, href, linkLabel } = Astro.props;
---

<div class="mb-5 flex items-end justify-between gap-4">
  <div>
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h2 class="display text-2xl uppercase sm:text-3xl">{title}</h2>
  </div>
  {href && (
    <a href={href} class="link shrink-0 pb-1 text-[13px]">{linkLabel ?? 'See all'} →</a>
  )}
</div>
