# Read-only role the site connects as.
DATABASE_URL=postgres://tracker_web:change-me@localhost:5432/martin_garrix_tracker

# Owner role, used only by `bun run db:migrate` and `bun run import`.
# Never give this to the web container.
DATABASE_OWNER_URL=postgres://tracker_owner:change-me@localhost:5432/martin_garrix_tracker
